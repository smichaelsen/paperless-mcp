.env
.env.local
.env.*.local

# Build output
dist/
build/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Isolated worktrees used by background agents
.claude/worktrees/

# Credentials for the disposable Paperless-ngx used by the integration lane.
.paperless-it.env
