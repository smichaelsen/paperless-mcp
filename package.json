{
  "name": "@smic/paperless-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for interacting with Paperless-NGX document management system. Enables AI assistants to manage documents, tags, correspondents, and document types through the Paperless-NGX API.",
  "main": "build/index.js",
  "bin": {
    "paperless-mcp": "build/index.js"
  },
  "files": [
    "build",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run",
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node build/index.js",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "mcp",
    "paperless-ngx",
    "document-management",
    "ai",
    "claude",
    "model-context-protocol",
    "paperless"
  ],
  "author": "Sebastian Michaelsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smichaelsen/paperless-mcp.git"
  },
  "homepage": "https://github.com/smichaelsen/paperless-mcp#readme",
  "bugs": {
    "url": "https://github.com/smichaelsen/paperless-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  }
}
